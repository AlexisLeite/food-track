HOST=127.0.0.1
PORT=3086
APP_ORIGIN=http://localhost:3086
DATA_DIR=./data
# SQLite stays in DATA_DIR. Configure external photo storage only on this host:
# FOODTRACK_PHOTOS_DIR=/mnt/scraper-db/food-track/photos
# FOODTRACK_MEDIA_MOUNT=/mnt/scraper-db
# FOODTRACK_MEDIA_UUID=301f3153-374a-4a01-99ba-7d9979e3bf01
# El servidor ejecuta Codex con el usuario que ya tiene sesión iniciada.
CODEX_BIN=/usr/local/bin/codex
# COOKIE_SECURE=true al publicar con HTTPS
COOKIE_SECURE=false
WHISPER_MODEL=small
# WHISPER_PYTHON=/repos/foodtrack/.venv/bin/python
