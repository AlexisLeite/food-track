[Unit]
Description=Comida - diario de calorias
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/repos/foodtrack
EnvironmentFile=/repos/foodtrack/.env
Environment=HOME=/root
Environment=FOODTRACK_PHOTOS_DIR=/mnt/scraper-db/food-track/photos
Environment=FOODTRACK_MEDIA_MOUNT=/mnt/scraper-db
Environment=FOODTRACK_MEDIA_UUID=301f3153-374a-4a01-99ba-7d9979e3bf01
ExecStart=/usr/bin/node /repos/foodtrack/server/index.js
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
